NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority&appName=your-app

JWT_SECRET=replace-with-a-long-random-string

DEV_BACKEND_URL=http://localhost:5000
DEV_FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://your-frontend.example.com
BACKEND_URL=https://your-backend.example.com

# Comma-separated list of origins allowed to send credentialed requests
ALLOWED_ORIGINS=https://your-frontend.example.com,http://localhost:5173

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
CDN_BASE_URL=https://your-cdn-domain.example.com

KIE_API_KEY=your-kie-api-key
