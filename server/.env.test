# Test-only environment. Loaded by tests/env-guard.ts with override:true, so it
# always wins over .env. Every value here is a dummy — nothing in the suite calls
# Resend, R2 or kie.ai. Never copy real credentials into this file.
#
# config/env.ts runs envSchema.parse(process.env) at import time and the R2 keys,
# CDN_BASE_URL and RESEND_API_KEY have no defaults, so all of them must be present
# even though they are unused here.
#
# NODE_ENV must be "development": env.ts only resolves DEV_REDIS_URL in that mode
# and otherwise demands the production REDIS_URL. tests/env-guard.ts enforces this,
# and refuses to run at all unless both URLs below are on localhost.

NODE_ENV=development
PORT=5051

# Local services only. env-guard.ts rejects anything else, because setup.ts calls
# redis flushDb() and drops the Mongo database.
DEV_REDIS_URL=redis://127.0.0.1:6379/15
MONGO_URI=mongodb://127.0.0.1:27017/online-study-app-test

JWT_SECRET=test-only-jwt-secret-not-used-anywhere-else
ALLOWED_ORIGINS=http://localhost:5173

R2_ACCOUNT_ID=test-account
R2_ACCESS_KEY_ID=test-key-id
R2_SECRET_ACCESS_KEY=test-secret
R2_BUCKET_NAME=test-bucket
R2_ENDPOINT=https://example.invalid
CDN_BASE_URL=https://cdn.example.invalid
RESEND_API_KEY=re_test_not_a_real_key
CONTACT_TO_EMAIL=contact@example.invalid
CONTACT_FROM_EMAIL=contact@example.invalid
